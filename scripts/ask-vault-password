#!/bin/sh

if ! exec 3</dev/tty; then
    printf '%s\n' 'Unable to open the terminal for the vault password prompt.' >&2
    exit 1
fi

restore_terminal() {
    stty echo <&3 2>/dev/null || true
}

trap restore_terminal EXIT INT TERM

printf 'Vault password: ' >&3
stty -echo <&3
IFS= read -r vault_password <&3
stty echo <&3
printf '\n' >&3
printf '%s' "$vault_password"
